---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { config, waLink } from '@/data/config';

// Breadcrumb
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${config.dominio}/` },
    { "@type": "ListItem", "position": 2, "name": "Quiénes Somos", "item": `${config.dominio}/quienes-somos/` }
  ]
};
---

<BaseLayout
  title="Quiénes Somos - Alexandro Refrigeration HVACR en NJ | EPA 608"
  description="Conoce la historia de Alexandro Refrigeration HVAC Parts & Repair Services. Compañía líder en reparación de refrigeración comercial y HVAC en New Jersey. Licencia EPA 608."
  canonical="/quienes-somos/"
  skipBreadcrumb={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- HERO -->
  <section class="relative pt-12 pb-12 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute top-0 left-0 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>

    <div class="container-x relative">
      <nav class="flex items-center gap-2 text-xs text-white mb-8">
        <a href="/es/" class="hover:text-neon-400 transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-neon-400">Quiénes Somos</span>
      </nav>

      <div class="text-center max-w-4xl mx-auto">
        <span class="badge-neon mb-4">Bienvenido a la Compañía Líder</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-[#4267B2] mb-6 leading-tight text-balance">
          Quiénes <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">Somos</span>
        </h1>
        <p class="text-lg md:text-xl text-white mb-8 leading-relaxed">
          Bienvenido a la Compañía Líder en Reparaciones <strong class="text-white">Alexandro Refrigeration HVAC Parts & Repair Services</strong>. Reparación profesional de refrigeración comercial y HVAC en New Jersey, USA.
        </p>
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section class="py-12 relative">
    <div class="container-x">
      <div class="max-w-4xl mx-auto prose prose-invert prose-lg">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-4">
          Nuestra <span class="text-neon-400">Historia</span>
        </h2>
        <p class="text-white leading-relaxed mb-4">
          Alexandro Refrigeration HVAC Parts & Repair Services nació del esfuerzo y la dedicación de su fundador, quien comenzó en el rubro trabajando como <strong class="text-white">ayudante</strong> en talleres de refrigeración y HVAC. Con el paso de los años, aprendió el oficio, dominó el manejo de sistemas de refrigeración comercial y decidió tomar el siguiente paso.
        </p>
        <p class="text-white leading-relaxed mb-4">
          Obtuvo su <strong class="text-neon-400">Licencia 608 de la EPA</strong> — la certificación federal obligatoria en Estados Unidos para comprar, manejar y recargar gas refrigerante. Con esta credencial en mano, registró formalmente la compañía para servir a la comunidad hispana y anglo de New Jersey, ofreciendo un servicio profesional, honesto y responsable.
        </p>
        <p class="text-white leading-relaxed">
          Hoy, Alexandro Refrigeration HVACR es la compañía líder en reparaciones de refrigeración comercial y HVAC en 10 ciudades de New Jersey, atendiendo <strong class="text-white">restaurantes, hoteles, supermercados, licorerías y cafeterías</strong> con repuestos de calidad, técnica profesional y garantía de 3 meses en cada trabajo.
        </p>
      </div>
    </div>
  </section>

  <!-- Misión y Valores -->
  <section class="py-12 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-10"></div>
    <div class="container-x relative">
      <div class="text-center mb-10">
        <span class="badge-neon mb-3">Misión</span>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-4">
          Nuestra <span class="text-neon-400 glow-text">Misión</span>
        </h2>
        <p class="text-white max-w-2xl mx-auto">
          Ofrecer servicio profesional de reparación de refrigeración comercial y HVAC en New Jersey, con honestidad, responsabilidad y calidad garantizada.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        <div class="card-neon text-center">
          <div class="text-4xl mb-3">🤝</div>
          <h3 class="text-lg font-display font-bold text-neon-400 mb-2 uppercase">Profesionalismo</h3>
          <p class="text-sm text-white">Técnicos certificados EPA 608 con experiencia en equipos comerciales y residenciales.</p>
        </div>
        <div class="card-neon text-center">
          <div class="text-4xl mb-3">⚖️</div>
          <h3 class="text-lg font-display font-bold text-neon-400 mb-2 uppercase">Honestidad</h3>
          <p class="text-sm text-white">Presupuestos transparentes, sin costos ocultos. Te explicamos todo antes de empezar.</p>
        </div>
        <div class="card-neon text-center">
          <div class="text-4xl mb-3">🛡️</div>
          <h3 class="text-lg font-display font-bold text-neon-400 mb-2 uppercase">Responsabilidad</h3>
          <p class="text-sm text-white">Cumplimos los plazos, atendemos emergencias 24/7 y cuidamos tu mercadería y tu negocio.</p>
        </div>
        <div class="card-neon text-center">
          <div class="text-4xl mb-3">✅</div>
          <h3 class="text-lg font-display font-bold text-neon-400 mb-2 uppercase">Garantía 3 meses</h3>
          <p class="text-sm text-white">Todos nuestros trabajos tienen garantía escrita de 3 meses. Tu tranquilidad primero.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- EPA License -->
  <section class="py-12 relative">
    <div class="container-x">
      <div class="max-w-4xl mx-auto">
        <div class="card-neon p-6 md:p-8 flex flex-col md:flex-row items-center gap-6 text-center md:text-left">
          <div class="shrink-0">
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-gradient-neon flex items-center justify-center shadow-neon-lg">
              <span class="text-4xl md:text-5xl">🛡️</span>
            </div>
          </div>
          <div class="flex-1">
            <div class="badge-neon mb-3">Certificación Federal</div>
            <h2 class="text-xl md:text-2xl font-display font-bold text-[#4267B2] mb-2">
              Licencia 608 de la <span class="text-neon-400 glow-text">EPA</span>
            </h2>
            <p class="text-sm md:text-base text-white mb-4">
              Nuestro técnico principal está certificado por la Environmental Protection Agency (EPA) bajo la Sección 608 del Clean Air Act. Esta licencia federal nos permite comprar, manejar y recargar gas refrigerante legalmente en Estados Unidos. Es un requisito obligatorio para cualquier trabajo profesional en sistemas de refrigeración y HVAC.
            </p>
            <div class="flex flex-wrap gap-2 justify-center md:justify-start">
              <span class="badge-neon">✓ Cumplimiento federal</span>
              <span class="badge-neon">✓ Manejo seguro de refrigerante</span>
              <span class="badge-neon">✓ Recarga legal de gas</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Clientes -->
  <section class="py-12 relative">
    <div class="container-x">
      <div class="text-center mb-10">
        <span class="badge-neon mb-3">Clientes</span>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-4">
          Negocios que <span class="text-neon-400 glow-text">Atendemos</span>
        </h2>
        <p class="text-white max-w-2xl mx-auto">
          Atendemos todo tipo de comercios en New Jersey que requieren refrigeración y HVAC profesional.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 max-w-4xl mx-auto">
        {config.clientesTipicos.map(cliente => (
          <div class="card-neon text-center">
            <div class="text-4xl mb-2">
              {cliente === 'restaurantes' ? '🍽️' : cliente === 'hoteles' ? '🏨' : cliente === 'supermercados' ? '🛒' : cliente === 'licorerías' ? '🍾' : '☕'}
            </div>
            <div class="text-sm font-display font-bold text-neon-400 uppercase tracking-wide">{cliente}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-dark-400 via-dark-300 to-dark-400"></div>
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="container-x relative text-center">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-4">
        ¿Listo para trabajar <span class="text-neon-400 glow-text">con nosotros</span>?
      </h2>
      <p class="text-white mb-8 max-w-2xl mx-auto">
        Escríbenos por WhatsApp y coordina tu visita. Atendemos en 10 ciudades de New Jersey con técnico certificado EPA 608.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp: {config.telefonoDisplay}
        </a>
        <a href="/contacto/" class="btn-outline-neon">Formulario de contacto</a>
      </div>
    </div>
  </section>
</BaseLayout>
