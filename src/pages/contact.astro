---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { configEn, waLinkEn } from '@/data/config-en';
import { citiesEn } from '@/data/cities-en';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${configEn.dominio}/en/` },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": `${configEn.dominio}/en/contact/` }
  ]
};
---

<BaseLayout
  lang="en"
  title="Contact Us | Alexandro HVACR"
  description="Contact Alexandro Refrigeration HVACR for refrigeration and HVAC repair in New Jersey. WhatsApp 937-450-0421, EPA 608 certified, 3-month warranty."
  canonical="/contact/"
  skipBreadcrumb={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="relative pt-12 pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>
    <div class="container-x relative">
      <nav class="flex items-center gap-2 text-xs text-white mb-8">
        <a href="/" class="hover:text-neon-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-neon-400">Contact</span>
      </nav>
      <div class="text-center max-w-4xl mx-auto">
        <span class="badge-neon mb-4">Contact</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-[#4267B2] mb-6 leading-tight text-balance">
          Get in <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">Touch</span>
        </h1>
        <p class="text-lg md:text-xl text-white mb-8 leading-relaxed">
          Need refrigeration or HVAC repair? Message us on WhatsApp or call us. EPA 608 certified technician, 3-month warranty.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 relative">
    <div class="container-x">
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <a href={waLinkEn()} target="_blank" rel="noopener" class="card-neon text-center group">
          <div class="w-16 h-16 mx-auto rounded-full bg-[#25D366]/10 flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
            </svg>
          </div>
          <h2 class="text-lg font-display font-bold text-white mb-2">WhatsApp</h2>
          <p class="text-sm text-white">{configEn.telefonoDisplay}</p>
        </a>
        <a href={`tel:${configEn.telefonoHref}`} class="card-neon text-center group">
          <div class="w-16 h-16 mx-auto rounded-full bg-neon-500/10 flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <h2 class="text-lg font-display font-bold text-white mb-2">Call</h2>
          <p class="text-sm text-white">{configEn.telefonoDisplay}</p>
        </a>
        <a href={configEn.googleUrl} target="_blank" rel="noopener" class="card-neon text-center group">
          <div class="w-16 h-16 mx-auto rounded-full bg-neon-500/10 flex items-center justify-center mb-4">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>
          <h2 class="text-lg font-display font-bold text-white mb-2">Google</h2>
          <p class="text-sm text-white">View Profile</p>
        </a>
      </div>

      <div class="max-w-4xl mx-auto mt-12">
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card-neon">
            <h2 class="text-lg font-display font-bold text-neon-400 mb-4 uppercase tracking-wide">Information</h2>
            <ul class="space-y-3 text-sm text-white">
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <a href={`tel:${configEn.telefonoHref}`} class="hover:text-neon-400">{configEn.telefonoDisplay}</a>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                {configEn.email}
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {configEn.horario}
              </li>
            </ul>
          </div>
          <div class="card-neon">
            <h2 class="text-lg font-display font-bold text-neon-400 mb-4 uppercase tracking-wide">Certification</h2>
            <div class="flex items-center gap-4 mb-4">
              <div class="w-16 h-16 rounded-lg bg-neon-500/10 border border-neon-500/30 flex items-center justify-center text-3xl">🛡️</div>
              <div>
                <div class="text-lg font-display font-bold text-neon-400">EPA 608</div>
                <div class="text-sm text-white">Federal Certification</div>
              </div>
            </div>
            <p class="text-sm text-white">
              Our technician is certified by the Environmental Protection Agency (EPA) under Section 608 of the Clean Air Act. This allows us to legally purchase, handle and recharge refrigerant gas in the United States.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
