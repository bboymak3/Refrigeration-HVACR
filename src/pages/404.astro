---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { configEn } from '@/data/config-en';
---

<BaseLayout
  lang="en"
  title="Page Not Found - 404 | Alexandro HVACR"
  description="The page you are looking for does not exist or has been removed."
  skipBreadcrumb={true}
  skipAutoRepair={true}
>
  <section class="py-20 md:py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-10"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>
    <div class="container-x relative text-center">
      <div class="text-9xl md:text-[12rem] font-display font-extrabold text-neon-400 glow-text mb-4 leading-none">
        404
      </div>
      <h1 class="text-2xl md:text-4xl font-display font-bold text-[#4267B2] mb-4">
        Page Not Found
      </h1>
      <p class="text-white max-w-2xl mx-auto mb-8">
        The page you are looking for does not exist or has been removed. The URL may be incorrect or the content may have been moved.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="btn-neon">
          Back to Home
        </a>
        <a href="/services/" class="btn-outline-neon">
          View Services
        </a>
        <a href="/cities/" class="btn-outline-neon">
          View Cities
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
