---
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import { config, waLink } from '@/data/config';

// Breadcrumb
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${config.dominio}/` },
    { "@type": "ListItem", "position": 2, "name": "Contacto", "item": `${config.dominio}/contacto/` }
  ]
};
---

<BaseLayout
  title="Contacto - Alexandro Refrigeration HVACR en NJ | WhatsApp y Teléfono"
  description="Contacta a Alexandro Refrigeration HVACR en New Jersey. WhatsApp, teléfono y formulario de cotización. Licencia EPA 608, emergencias 24/7. Llama al 937-450-0421."
  canonical="/contacto/"
  skipBreadcrumb={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- HERO -->
  <section class="relative pt-12 pb-12 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute top-0 left-0 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>

    <div class="container-x relative">
      <nav class="flex items-center gap-2 text-xs text-white mb-8">
        <a href="/" class="hover:text-neon-400 transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-neon-400">Contacto</span>
      </nav>

      <div class="text-center max-w-4xl mx-auto">
        <span class="badge-neon mb-4">Contacto</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-[#4267B2] mb-6 leading-tight text-balance">
          Contáctanos en <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">New Jersey</span>
        </h1>
        <p class="text-lg md:text-xl text-white mb-8 leading-relaxed">
          Estamos disponibles para atenderte. Elige el medio que prefieras: WhatsApp, teléfono o formulario. Respuesta en minutos.
        </p>
      </div>
    </div>
  </section>

  <!-- Cards de contacto directo -->
  <section class="py-8 relative">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <!-- WhatsApp -->
        <a href={waLink()} target="_blank" rel="noopener" class="card-neon group text-center">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-[#25D366]/10 border border-[#25D366]/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </div>
          <h2 class="text-lg font-display font-bold text-[#4267B2] mb-2">WhatsApp</h2>
          <p class="text-sm text-white mb-3">Respuesta en 5-15 min</p>
          <div class="text-[#25D366] font-bold">{config.telefonoDisplay}</div>
        </a>

        <!-- Teléfono -->
        <a href={`tel:${config.telefonoHref}`} class="card-neon group text-center">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <h2 class="text-lg font-display font-bold text-[#4267B2] mb-2">Llamar</h2>
          <p class="text-sm text-white mb-3">Lun a Sáb: 08:00 - 20:00</p>
          <div class="text-orange-400 font-bold">{config.telefonoDisplay}</div>
        </a>

        <!-- Google -->
        <a href={config.googleUrl} target="_blank" rel="noopener" class="card-neon group text-center">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-white/5 border border-neon-500/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>
          <h2 class="text-lg font-display font-bold text-[#4267B2] mb-2">Google</h2>
          <p class="text-sm text-white mb-3">Ver perfil y reseñas</p>
          <div class="text-neon-400 font-bold">Ver perfil →</div>
        </a>
      </div>
    </div>
  </section>

  <!-- Info de contacto -->
  <section class="py-8 relative">
    <div class="container-x">
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card-neon">
          <h2 class="text-lg font-display font-bold text-neon-400 mb-4 uppercase tracking-wide">Información</h2>
          <ul class="space-y-3 text-sm text-white">
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span><strong class="text-white">Cobertura:</strong> 10 ciudades de New Jersey, USA</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span><strong class="text-white">Horario:</strong> {config.horario}</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span><strong class="text-white">Teléfono:</strong> <a href={`tel:${config.telefonoHref}`} class="hover:text-neon-400">{config.telefonoDisplay}</a></span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span><strong class="text-white">Email:</strong> {config.email}</span>
            </li>
          </ul>
        </div>

        <div class="card-neon">
          <h2 class="text-lg font-display font-bold text-neon-400 mb-4 uppercase tracking-wide">Certificación</h2>
          <div class="flex items-center gap-4 mb-4">
            <div class="w-16 h-16 rounded-xl bg-gradient-neon flex items-center justify-center shadow-neon shrink-0">
              <span class="text-3xl">🛡️</span>
            </div>
            <div>
              <div class="font-display font-bold text-white">Licencia 608 de la EPA</div>
              <div class="text-xs text-white">Environmental Protection Agency</div>
            </div>
          </div>
          <p class="text-sm text-white">
            Certificación federal vigente para manejo legal de gas refrigerante en sistemas de refrigeración y HVAC en Estados Unidos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Formulario de cotización -->
  <QuoteForm />
</BaseLayout>
