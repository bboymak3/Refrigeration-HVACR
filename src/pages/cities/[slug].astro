---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CityMap from '@/components/CityMap.astro';
import RealGallery from '@/components/RealGallery.astro';
import { cities } from '@/data/cities';
import { servicios } from '@/data/servicios';
import { config, waLink, waLinkCiudad, waLinkServicio } from '@/data/config';

export function getStaticPaths() {
  return cities.map(c => ({
    params: { slug: c.slug },
    props: { city: c }
  }));
}

const { city } = Astro.props;
const esDestacada = city.destacada === true;
const colorText = esDestacada ? 'text-orange-400' : 'text-neon-400';
const colorBadge = esDestacada ? 'badge-orange' : 'badge-neon';

// Schema 1: LocalBusiness (AutoRepair) para la ciudad
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": `Alexandro Refrigeration HVACR - ${city.nombre}, NJ`,
  "alternateName": `Refrigeration & HVAC Repair ${city.nombre}`,
  "description": `Servicio de reparación de refrigeración comercial y HVAC en ${city.nombre}, NJ. ${city.descripcion}`,
  "url": `${config.dominio}/cities/${city.slug}/`,
  "telephone": config.telefonoDisplay,
  "email": config.email,
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city.nombre,
    "addressRegion": city.state,
    "addressCountry": "US"
  },
  "areaServed": {
    "@type": "City",
    "name": `${city.nombre}, ${city.state}`
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "08:00",
      "closes": "20:00"
    }
  ],
  "sameAs": [config.googleUrl]
};

// Schema 2: Service
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `Refrigeration & HVAC Repair in ${city.nombre}, NJ`,
  "serviceType": "Refrigeration & HVAC Repair",
  "description": `Servicio de refrigeración comercial, HVAC, cuartos fríos y equipos de cocina en ${city.nombre}, NJ. Técnico certificado EPA 608.`,
  "url": `${config.dominio}/cities/${city.slug}/`,
  "provider": {
    "@type": "AutoRepair",
    "name": config.marcaLarga,
    "telephone": config.telefonoDisplay,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": city.nombre,
      "addressRegion": city.state,
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": city.nombre
  }
};

// Schema 3: Breadcrumb
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${config.dominio}/` },
    { "@type": "ListItem", "position": 2, "name": "Ciudades", "item": `${config.dominio}/cities/` },
    { "@type": "ListItem", "position": 3, "name": `${city.nombre}, NJ`, "item": `${config.dominio}/cities/${city.slug}/` }
  ]
};

// Schema 4: FAQPage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `¿Ofrecen servicio de refrigeration & HVAC repair en ${city.nombre}, NJ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Sí, en Alexandro Refrigeration HVACR ofrecemos servicio de refrigeración comercial y HVAC en ${city.nombre}, NJ. Nuestro técnico certificado con Licencia EPA 608 atiende restaurantes, supermercados, hoteles, licorerías y cafeterías en ${city.nombre} y alrededores.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Cuánto demoran en llegar a ${city.nombre}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Nuestro tiempo promedio de llegada a ${city.nombre} es de 45 a 60 minutos, dependiendo del tráfico y la hora del día. Para emergencias 24/7, priorizamos tu solicitud y llegamos lo antes posible.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Cuánto cuesta la reparación de refrigeración en ${city.nombre}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `El costo varía según el servicio y repuestos necesarios. Te entregamos un presupuesto transparente y sin compromiso antes de comenzar cualquier trabajo. Escríbenos por WhatsApp al ${config.telefonoDisplay} para una cotización personalizada.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Tienen Licencia EPA 608 para trabajar en ${city.nombre}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Sí, nuestro técnico cuenta con la Licencia 608 de la EPA (Environmental Protection Agency), requisito federal obligatorio para comprar, manejar y recargar gas refrigerante en sistemas de refrigeración y HVAC en ${city.nombre} y todo Estados Unidos.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Qué áreas de ${city.nombre} cubren?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Atendemos toda la ciudad de ${city.nombre}, NJ, incluyendo ${city.sectoresPopulares.join(', ')} y sectores aledaños. Si tu ubicación no aparece, contáctanos por WhatsApp para confirmar cobertura.`
      }
    }
  ]
};
---

<BaseLayout
  title={city.metaTitle}
  description={city.metaDescription}
  canonical={`/cities/${city.slug}/`}
  skipBreadcrumb={true}
  skipAutoRepair={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <section class="relative pt-12 pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class={`absolute top-0 left-0 w-96 h-96 ${esDestacada ? 'bg-orange-500/10' : 'bg-neon-500/10'} rounded-full blur-3xl`}></div>

    <div class="container-x relative">
      <nav class="flex items-center gap-2 text-xs text-white mb-8 flex-wrap">
        <a href="/" class="hover:text-neon-400 transition-colors">Inicio</a>
        <span>/</span>
        <a href="/cities/" class="hover:text-neon-400 transition-colors">Ciudades</a>
        <span>/</span>
        <span class={colorText}>{city.nombre}</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class={`w-16 h-16 rounded-lg ${esDestacada ? 'bg-orange-500/10 border-orange-500' : 'bg-neon-500/10 border-neon-500/30'} border-2 flex items-center justify-center shadow-neon`}>
              <svg class={`w-8 h-8 ${esDestacada ? 'text-orange-400' : 'text-neon-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div class="flex flex-col gap-1">
              <span class={colorBadge}>USA</span>
              {esDestacada && <span class="text-[10px] px-2 py-0.5 bg-orange-500 text-dark-500 rounded font-bold uppercase tracking-wider w-fit">★ Ciudad Destacada</span>}
            </div>
          </div>

          <h1 class={`text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-white mb-4 text-balance ${esDestacada ? 'glow-text-orange' : 'glow-text'}`}>
            {city.h1}
          </h1>

          <p class="text-lg text-white mb-8 leading-relaxed">
            {city.descripcion} Reparación de Refrigeración Comercial, HVAC, Cuartos Fríos y más con técnico certificado <strong class={colorText}>Licencia 608 de la EPA</strong>.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 mb-8">
            <a href={waLinkCiudad(city.nombre)} target="_blank" rel="noopener" class="btn-whatsapp animate-pulse-neon">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              WhatsApp: {config.telefonoDisplay}
            </a>
            <a href={`tel:${config.telefonoHref}`} class="btn-outline-neon">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Llamar
            </a>
          </div>

          <!-- Sectores populares -->
          <div>
            <h3 class={`text-sm font-display font-bold ${colorText} uppercase tracking-widest mb-3`}>Áreas populares en {city.nombre}</h3>
            <div class="flex flex-wrap gap-2">
              {city.sectoresPopulares.map(s => (
                <span class={colorBadge}>{s}</span>
              ))}
            </div>
          </div>
        </div>

        <!-- Card lateral con logo grande (igual al hero de la home) -->
        <div class="relative order-1 lg:order-2">
          <div class="relative max-w-lg mx-auto">
            <!-- Glow ring -->
            <div class="absolute -inset-4 rounded-2xl bg-gradient-neon opacity-20 blur-2xl"></div>

            <!-- Tarjeta principal -->
            <div class="relative aspect-square rounded-2xl overflow-hidden border-2 border-neon-500/40 shadow-neon-lg bg-gradient-to-br from-dark-200 via-dark-300 to-dark-400">
              <!-- Logo central flotando -->
              <div class="absolute inset-0 flex items-center justify-center p-8">
                <img
                  src="/images/Refrigeration-HVAC-Repair-in-New-Jersey-logo.webp"
                  alt="Alexandro Refrigeration HVACR - Logo"
                  class="w-full h-full object-contain animate-float drop-shadow-[0_0_30px_rgba(0,212,255,0.4)]"
                  loading="eager"
                />
              </div>

              <!-- Badge flotante superior -->
              <div class="absolute top-4 left-4 px-3 py-1.5 bg-neon-500/90 backdrop-blur rounded-lg border border-neon-400 text-dark-500 text-xs font-bold uppercase tracking-wider shadow-neon">
                🛡️ EPA 608 Certified
              </div>

              <!-- Texto inferior -->
              <div class="absolute bottom-4 left-4 right-4">
                <div class="text-xs text-neon-400 uppercase tracking-wider mb-1 font-semibold">ALEXANDRO HVACR</div>
                <div class="text-white font-display font-bold text-lg leading-tight">Refrigeration & HVAC Repair in {city.nombre}</div>
              </div>
            </div>

            <!-- Floating badges (solo desktop) -->
            <div class="hidden md:block absolute top-8 -right-4 card-neon p-3 animate-float" style="animation-delay: 0s;">
              <div class="flex items-center gap-2">
                <span class="text-2xl">🛠️</span>
                <div>
                  <div class="text-xs text-white">Garantía</div>
                  <div class="text-sm font-bold text-neon-400">3 meses</div>
                </div>
              </div>
            </div>
            <div class="hidden md:block absolute bottom-12 -left-4 card-neon p-3 animate-float" style="animation-delay: 1s;">
              <div class="flex items-center gap-2">
                <span class="text-2xl">⚡</span>
                <div>
                  <div class="text-xs text-white">Emergencias</div>
                  <div class="text-sm font-bold text-neon-400">24/7</div>
                </div>
              </div>
            </div>
            <div class="hidden lg:block absolute top-1/2 -right-8 card-neon p-3 animate-float" style="animation-delay: 2s;">
              <div class="flex items-center gap-2">
                <span class="text-2xl">🏪</span>
                <div>
                  <div class="text-xs text-white">Para</div>
                  <div class="text-sm font-bold text-neon-400">Negocios</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios en esta ciudad -->
  <section id="servicios-disponibles" class="py-16 relative">
    <div class="container-x">
      <div class="text-center mb-10">
        <span class="badge-neon mb-4">Servicios en {city.nombre}</span>
        <h2 class="text-3xl font-display font-bold text-[#4267B2] mb-4">
          Servicios de Refrigeración en <span class="text-neon-400">{city.nombre}</span>
        </h2>
        <p class="text-white max-w-2xl mx-auto">
          Todos nuestros servicios de refrigeración comercial y HVAC están disponibles en {city.nombre}. Selecciona el que necesitas y contáctanos por WhatsApp.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicios.map(servicio => (
          <div class="card-neon group">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-12 h-12 rounded-lg bg-neon-500/10 border border-neon-500/30 flex items-center justify-center text-2xl">
                {servicio.icono}
              </div>
              <h3 class="font-display font-bold text-white group-hover:text-neon-400 transition-colors">
                <a href={`/servicios/${servicio.slug}/`}>{servicio.nombre}</a>
              </h3>
            </div>
            <p class="text-sm text-white mb-4">{servicio.descripcionCorta}</p>
            <div class="flex flex-col gap-2">
              <a href={`/servicios/${servicio.slug}/`} class="text-xs font-semibold text-neon-400 hover:text-neon-300 inline-flex items-center gap-1">
                Ver detalles
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
              <a
                href={waLinkServicio(`${servicio.nombre} en ${city.nombre}`)}
                target="_blank"
                rel="noopener"
                class="text-xs px-3 py-2 rounded-md bg-[#25D366]/10 border border-[#25D366]/30 text-[#25D366] hover:bg-[#25D366] hover:text-white transition-all inline-flex items-center gap-1.5 w-fit"
              >
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                Cotizar en {city.nombre}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Áreas que cubrimos (Mapa) -->
  <section class="py-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-10"></div>
    <div class="container-x relative">
      <div class="text-center mb-8">
        <span class="badge-neon mb-3">Cobertura</span>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-3">
          Áreas que Cubrimos en <span class="text-neon-400 glow-text">{city.nombre}</span>
        </h2>
        <p class="text-white max-w-2xl mx-auto text-sm">
          {city.nombre} está destacada en el mapa. Haz click en cualquier marcador para ver esa ciudad.
        </p>
      </div>
      <CityMap />
      <!-- Resaltar ciudad actual al cargar -->
      <script is:inline define:vars={{ citySlug: city.slug, cityName: city.nombre }}>
        window.addEventListener('load', () => {
          setTimeout(() => {
            if (window.resaltarCityEnMapa) {
              window.resaltarCityEnMapa(citySlug, cityName);
            }
          }, 1200);
        });
      </script>
    </div>
  </section>

  <!-- Sobre nosotros en esta ciudad -->
  <section class="py-12 relative">
    <div class="container-x">
      <div class="max-w-4xl mx-auto prose prose-invert prose-lg">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-4">
          Sobre Nosotros en <span class="text-neon-400">{city.nombre}</span>
        </h2>
        <p class="text-white leading-relaxed mb-4">
          Alexandro Refrigeration HVAC Parts & Repair Services es la compañía líder en reparaciones de refrigeración comercial y HVAC en {city.nombre}, New Jersey. Nuestro fundador comenzó como ayudante en el rubro, obtuvo su <strong class="text-neon-400">Licencia 608 de la EPA</strong> y registró la compañía para servir a la comunidad hispana y anglo de New Jersey.
        </p>
        <p class="text-white leading-relaxed mb-4">
          Atendemos <strong class="text-white">restaurantes, hoteles, supermercados, licorerías y cafeterías</strong> en {city.nombre} y alrededores. Reparamos refrigeradores comerciales, freezers, vitrinas exhibidoras, walk-in coolers, sistemas de aire acondicionado, hornos (furnaces), bombas de calor, estufas y freidoras comerciales.
        </p>
        <p class="text-white leading-relaxed">
          Ofrecemos <strong class="text-white">profesionalismo, honestidad, responsabilidad y garantía de 3 meses</strong> en todos nuestros trabajos en {city.nombre}. Atendemos emergencias 24/7 — si tu refrigerador comercial o walk-in cooler falla, escríbenos por WhatsApp al {config.telefonoDisplay} y coordinamos visita de urgencia.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 relative">
    <div class="container-x">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="badge-neon mb-3">FAQ</span>
          <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-3">
            FAQ Refrigeration Repair <span class="text-neon-400">{city.nombre}</span>
          </h2>
        </div>
        <div class="space-y-3">
          {faqSchema.mainEntity.map((f) => (
            <details class="card-neon group">
              <summary class="cursor-pointer text-sm font-semibold text-white flex items-center justify-between gap-3 list-none">
                {f.name}
                <svg class="w-5 h-5 text-neon-400 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-sm text-white mt-3 leading-relaxed">{f.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Galería de fotos en esta ciudad -->
  <RealGallery
    limit={6}
    offset={cities.findIndex(c => c.slug === city.slug) * 3}
    titulo={`Galería de Trabajos en ${city.nombre}`}
    subtitulo="Fotos reales de reparaciones de refrigeración comercial, HVAC, cuartos fríos, freezers y más realizadas por nuestro técnico certificado EPA 608 en New Jersey."
    showVerMas={true}
    sectionId="galeria-ciudad"
  />

  <!-- CTA final -->
  <section class="py-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-dark-400 via-dark-300 to-dark-400"></div>
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="container-x relative text-center">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-4">
        ¿Necesitas <span class={colorText}>Refrigeration & HVAC Repair</span> en {city.nombre}?
      </h2>
      <p class="text-white mb-8 max-w-2xl mx-auto">
        Escríbenos por WhatsApp ahora y coordina tu visita. Atención rápida, profesional y con garantía de 3 meses en {city.nombre}.
      </p>
