---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CityMap from '@/components/CityMap.astro';
import { cities } from '@/data/cities';
import { config, waLink } from '@/data/config';

const pageTitle = 'Ciudades de Cobertura en New Jersey';

// Schema: ItemList de ciudades
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Ciudades de cobertura en New Jersey",
  "description": "10 ciudades de New Jersey donde Alexandro Refrigeration HVACR ofrece servicio de refrigeración y HVAC.",
  "itemListElement": cities.map((c, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": `${c.nombre}, NJ`,
    "url": `${config.dominio}/cities/${c.slug}/`
  }))
};

// Breadcrumb
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${config.dominio}/` },
    { "@type": "ListItem", "position": 2, "name": "Ciudades", "item": `${config.dominio}/cities/` }
  ]
};
---

<BaseLayout
  title="Ciudades de Cobertura en New Jersey | Alexandro HVACR"
  description="Atendemos 10 ciudades de New Jersey con servicio de refrigeración comercial y HVAC. Newark, Kearny, Clifton, Passaic, Jersey City y más. Licencia EPA 608. WhatsApp 937-450-0421."
  canonical="/cities/"
  skipBreadcrumb={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- HERO -->
  <section class="relative pt-12 pb-12 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute top-0 left-0 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>

    <div class="container-x relative">
      <nav class="flex items-center gap-2 text-xs text-white mb-8">
        <a href="/" class="hover:text-neon-400 transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-neon-400">Ciudades</span>
      </nav>

      <div class="text-center max-w-4xl mx-auto">
        <span class="badge-neon mb-4">Cobertura</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-[#4267B2] mb-6 leading-tight text-balance">
          Ciudades que <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">Cubrimos</span>
        </h1>
        <p class="text-lg md:text-xl text-white mb-8 leading-relaxed">
          Atendemos <strong class="text-neon-400">{cities.length} ciudades de New Jersey</strong> con servicio profesional de refrigeración comercial y HVAC. Técnico certificado EPA 608, garantía de 3 meses.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            WhatsApp: {config.telefonoDisplay}
          </a>
          <a href={`tel:${config.telefonoHref}`} class="btn-outline-neon">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Llamar
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mapa interactivo -->
  <section class="py-8 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-10"></div>
    <div class="container-x relative">
      <div class="text-center mb-8">
        <span class="badge-neon mb-3">Mapa</span>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-3">
          Mapa de <span class="text-neon-400 glow-text">Cobertura</span>
        </h2>
        <p class="text-white max-w-2xl mx-auto text-sm">
          Haz click en un marcador para ver la landing de servicios de esa ciudad.
        </p>
      </div>
      <CityMap />
    </div>
  </section>

  <!-- Grid de ciudades -->
  <section class="py-12 relative">
    <div class="container-x">
      <div class="text-center mb-10">
        <span class="badge-neon mb-4">Ciudades</span>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-3">
          Selecciona tu <span class="text-neon-400">Ciudad</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {cities.map(c => (
          <a href={`/cities/${c.slug}/`} class={`card-neon group ${c.destacada ? 'border-orange-500/50 hover:border-orange-500' : ''}`}>
            <div class="flex items-start gap-4">
              <div class={`w-14 h-14 rounded-lg ${c.destacada ? 'bg-orange-500/10 border-2 border-orange-500' : 'bg-neon-500/10 border-2 border-neon-500/30'} flex items-center justify-center shrink-0`}>
                <svg class={`w-7 h-7 ${c.destacada ? 'text-orange-400' : 'text-neon-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <h3 class={`text-lg font-display font-bold ${c.destacada ? 'text-orange-400' : 'text-white group-hover:text-neon-400'} transition-colors`}>
                    {c.nombre}
                  </h3>
                  {c.destacada && <span class="text-[10px] px-2 py-0.5 bg-orange-500 text-dark-500 rounded font-bold uppercase">★</span>}
                </div>
                <div class="text-[10px] text-neon-400/70 uppercase tracking-wider mb-2">USA</div>
                <p class="text-xs text-white line-clamp-2">{c.descripcion}</p>
                <div class="mt-3 flex flex-wrap gap-1">
                  {c.sectoresPopulares.slice(0, 3).map(s => (
                    <span class="text-[10px] px-2 py-0.5 rounded bg-neon-500/10 border border-neon-500/20 text-neon-400">{s}</span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-dark-400 via-dark-300 to-dark-400"></div>
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="container-x relative text-center">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-4">
        ¿No ves tu <span class="text-neon-400 glow-text">ciudad</span>?
      </h2>
      <p class="text-white mb-8 max-w-2xl mx-auto">
        Probablemente también te atendemos. Escríbenos por WhatsApp para confirmar cobertura en tu área de New Jersey.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Consultar cobertura
        </a>
        <a href="/servicios/" class="btn-outline-neon">Ver servicios</a>
      </div>
    </div>
  </section>
</BaseLayout>
