---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Services from '@/components/Services.astro';
import CitiesHighlight from '@/components/CitiesHighlight.astro';
import CityMap from '@/components/CityMap.astro';
import RealGallery from '@/components/RealGallery.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import FreezerRepairSection from '@/components/FreezerRepairSection.astro';
import { configEn, waLinkEn } from '@/data/config-en';
import { serviciosEn } from '@/data/servicios-en';
import { citiesEn } from '@/data/cities-en';
import { galeriaImagenes } from '@/data/galeria';

// Schema.org para la home - AutoRepair
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": configEn.marcaLarga,
  "alternateName": configEn.marca,
  "description": "Refrigeration & HVAC Repair in New Jersey, USA. Commercial refrigeration, AC, walk-in coolers, freezers, ovens and fryers repair. EPA 608 certified.",
  "url": `${configEn.dominio}/en/`,
  "logo": `${configEn.dominio}/images/Refrigeration-HVAC-Repair-in-New-Jersey-logo.webp`,
  "image": `${configEn.dominio}/images/Refrigeration-HVAC-Repair-in-New-Jersey-logo.webp`,
  "telephone": configEn.telefonoDisplay,
  "email": configEn.email,
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "NJ",
    "addressCountry": "US"
  },
  "areaServed": citiesEn.map(c => ({ "@type": "City", "name": `${c.nombre}, NJ` })),
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "08:00",
      "closes": "20:00"
    }
  ],
  "sameAs": [configEn.googleUrl]
};

// Breadcrumb de home (solo Home)
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${configEn.dominio}/en/` }
  ]
};

// ItemList de servicios para home
const servicesItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Refrigeration & HVAC Services in New Jersey",
  "itemListElement": serviciosEn.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": s.nombre,
    "url": `${configEn.dominio}/en/services/${s.slug}/`
  }))
};
---

<BaseLayout lang="en" skipBreadcrumb={true} skipAutoRepair={true} skipEpaBadge={true}>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(servicesItemList)} />

  <!-- HERO FULL-WIDTH -->
  <Hero lang="en" />

  <!-- EPA License Badge -->
  <section class="py-8 md:py-10 relative overflow-hidden">
    <div class="container-x relative">
      <div class="max-w-4xl mx-auto">
        <div class="card-neon p-6 md:p-8 flex flex-col md:flex-row items-center gap-6 text-center md:text-left">
          <div class="shrink-0">
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-gradient-neon flex items-center justify-center shadow-neon-lg">
              <span class="text-4xl md:text-5xl">🛡️</span>
            </div>
          </div>
          <div class="flex-1">
            <div class="badge-neon mb-3">Federal Certification</div>
            <h2 class="text-xl md:text-2xl font-display font-bold text-[#4267B2] mb-2">
              EPA 608 <span class="text-neon-400 glow-text">Certification</span>
            </h2>
            <p class="text-sm md:text-base text-white mb-4">
              Our technician is certified by the Environmental Protection Agency (EPA) under Section 608 of the Clean Air Act. This allows us to purchase, handle and recharge refrigerant gas legally in the United States — a mandatory federal requirement.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de texto SEO -->
  <section class="py-12 relative">
    <div class="container-x">
      <div class="max-w-4xl mx-auto prose prose-invert prose-lg">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-4">
          Commercial Refrigeration & <span class="text-neon-400">HVAC</span> Repair
        </h2>
        <p class="text-white leading-relaxed mb-4">
          Alexandro Refrigeration H.V.A.C.R Parts & Repair Services is the leading commercial refrigeration and HVAC repair company. We serve <strong class="text-white">restaurants, hotels, supermarkets, liquor stores and cafes</strong> with professional, honest and responsible service.
        </p>
        <p class="text-white leading-relaxed mb-4">
          Our lead technician holds the <strong class="text-neon-400">EPA 608 Certification</strong>, a mandatory federal certification for refrigerant handling. We repair commercial refrigerators, freezers, display cases, walk-in coolers, air conditioning systems, furnaces, heat pumps, stoves and commercial fryers.
        </p>
        <p class="text-white leading-relaxed">
          We offer <strong class="text-white">professionalism, honesty, responsibility and a 3-month warranty</strong> on all our work. We handle 24/7 emergencies in 10 cities including Newark (Bloomfield Ave area), Kearny, Clifton, Passaic, Jersey City and more.
        </p>
      </div>
    </div>
  </section>

  <!-- Grid de Servicios -->
  <Services lang="en" />

  <!-- Ciudades destacadas (grid de links) -->
  <CitiesHighlight lang="en" />

  <!-- Galería de trabajos reales -->
  <RealGallery
    lang="en"
    limit={12}
    offset={0}
    titulo="Work Gallery"
    subtitulo={`Real photos of commercial refrigeration, HVAC, walk-in coolers, freezers, stoves and fryers repairs done by our EPA 608 certified technician. We have ${galeriaImagenes.length} photos of real jobs.`}
    showVerMas={true}
    sectionId="galeria-trabajos"
  />

  <!-- Sección de clientes -->
  <section class="py-12 relative">
    <div class="container-x">
      <div class="text-center mb-8">
        <span class="badge-neon mb-3">Trust</span>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-3">
          Businesses that <span class="text-neon-400">Trust Us</span>
        </h2>
        <p class="text-white max-w-2xl mx-auto">
          We serve all types of businesses that require professional refrigeration and HVAC service.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        {configEn.clientesTipicos.map(cliente => (
          <div class="card-neon text-center">
            <div class="text-3xl mb-2">
              {cliente === 'restaurants' ? '🍽️' : cliente === 'hotels' ? '🏨' : cliente === 'supermarkets' ? '🛒' : cliente === 'liquor stores' ? '🍾' : '☕'}
            </div>
            <div class="text-sm font-display font-bold text-neon-400 uppercase tracking-wide">{cliente}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sección de promesa -->
  <section class="py-12 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-10"></div>
    <div class="container-x relative">
      <div class="max-w-4xl mx-auto text-center">
        <div class="text-4xl mb-4">🤝</div>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-4">
          Our <span class="text-neon-400 glow-text">Promise</span>
        </h2>
        <p class="text-lg text-white leading-relaxed mb-6">
          "We offer <strong class="text-white">professionalism, honesty, responsibility and a 3-month warranty</strong> on every job. Our commitment is to get your business or home back to normal operation as soon as possible."
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-2xl mx-auto">
          <div class="badge-neon justify-center">✓ Professionalism</div>
          <div class="badge-neon justify-center">✓ Honesty</div>
          <div class="badge-neon justify-center">✓ Responsibility</div>
          <div class="badge-neon justify-center">✓ 3-month Warranty</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-12 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-10"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-neon-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="container-x relative">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-4">
          Do you need <span class="text-neon-400 glow-text">Refrigeration Repair</span>?
        </h2>
        <p class="text-white mb-8 max-w-2xl mx-auto">
          Message us on WhatsApp now and coordinate your visit. EPA 608 certified technician, quality parts and 3-month warranty.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={waLinkEn()} target="_blank" rel="noopener" class="btn-whatsapp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            WhatsApp: {configEn.telefonoDisplay}
          </a>
          <a href={`tel:${configEn.telefonoHref}`} class="btn-outline-neon">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Call
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mapa interactivo de áreas de servicio (movido al final, antes del footer) -->
  <section class="py-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-10"></div>
    <div class="container-x relative">
      <div class="text-center mb-8">
        <span class="badge-neon mb-3">Coverage</span>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#4267B2] mb-3">
          Where We <span class="text-neon-400 glow-text">Serve</span>
        </h2>
        <p class="text-white max-w-2xl mx-auto text-sm">
          Interactive map of the {citiesEn.length} cities where we offer refrigeration and HVAC service. Click a marker to view that city's landing page.
        </p>
      </div>
      <CityMap lang="en" />
    </div>
  </section>

  <!-- Freezer Repair + Appliance Repair + Brands Section -->
  <FreezerRepairSection lang="en" />

  <!-- Formulario de cotización -->
  <QuoteForm lang="en" />
</BaseLayout>
