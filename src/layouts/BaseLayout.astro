---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';
import BottomNav from '@/components/BottomNav.astro';
import GoogleReviewsModal from '@/components/GoogleReviewsModal.astro';
import EpaLicenseBadge from '@/components/EpaLicenseBadge.astro';
import Analytics from '@/components/Analytics.astro';
import { config } from '@/data/config';
import { configEn } from '@/data/config-en';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  skipBreadcrumb?: boolean;
  skipAutoRepair?: boolean;
  skipEpaBadge?: boolean;
  lang?: string;
}

const {
  lang = 'es-US',
  title,
  description,
  ogImage = '/images/Refrigeration-HVAC-Repair-in-New-Jersey-logo.webp',
  canonical,
  skipBreadcrumb = false,
  skipAutoRepair = false,
  skipEpaBadge = false,
} = Astro.props;

const isEn = lang === 'en';

const defaultTitle = isEn
  ? `${configEn.marcaLarga} | Refrigeration & HVAC Repair in New Jersey`
  : `${config.marcaLarga} | Refrigeration & HVAC Repair in New Jersey`;
const finalTitle = title || defaultTitle;

const defaultDescription = isEn
  ? 'Refrigeration & HVAC Repair in New Jersey. Commercial refrigeration, AC, walk-in coolers, freezers, ovens and fryers repair. EPA 608 certified, 3-month warranty. WhatsApp 937-450-0421.'
  : 'Refrigeration & HVAC Repair in New Jersey. Reparación de refrigeración comercial, AC, cuartos fríos, freezers, hornos y freidoras. Licencia EPA 608, garantía 3 meses. WhatsApp 937-450-0421.';
const finalDescription = description || defaultDescription;

const activeConfig = isEn ? configEn : config;

const currentUrl = canonical || Astro.url.pathname;
const fullUrl = new URL(currentUrl, activeConfig.dominio).toString();
const ogImageUrl = new URL(ogImage, activeConfig.dominio).toString();

const pageTitle = finalTitle.split('|')[0].trim();
const htmlLang = isEn ? 'en' : 'es-US';
const ogLocale = isEn ? 'en_US' : 'es_US';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{finalTitle}</title>
    <meta name="title" content={finalTitle} />
    <meta name="description" content={finalDescription} />
    <meta name="keywords" content="commercial refrigeration repair, newark cooler repair, newark hvac repairs, refrigeration newark nj bloomfield ave, hvac repair nj, refrigeration repair nj" />
    <meta name="author" content={activeConfig.marca} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={fullUrl} />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="AO8x2D5digAhJVNmj0wVdeJx60EpOc56vELa9rh_CmY" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={activeConfig.marca} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullUrl} />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon completo (todos los formatos) -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={activeConfig.marca} />
    <meta name="application-name" content={activeConfig.marca} />
    <meta name="msapplication-TileColor" content="#00d4ff" />
    <meta name="msapplication-TileImage" content="/android-chrome-192x192.png" />
    <meta name="theme-color" content="#00d4ff" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Structured Data: AutoRepair base (solo si la página no define el suyo propio) -->
    {!skipAutoRepair && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "AutoRepair",
        "name": activeConfig.marcaLarga,
        "alternateName": activeConfig.marca,
        "image": ogImage,
        "description": isEn
          ? "Refrigeration & HVAC Repair in New Jersey, USA. Commercial refrigeration, AC, walk-in coolers, freezers, ovens and fryers repair. EPA 608 certified."
          : "Refrigeration & HVAC Repair in New Jersey, USA. Reparación de refrigeración comercial, AC, cuartos fríos, freezers, hornos y freidoras. Licencia EPA 608.",
        "url": activeConfig.dominio,
        "telephone": activeConfig.telefonoDisplay,
        "email": activeConfig.email,
        "address": {
          "@type": "PostalAddress",
          "addressRegion": "NJ",
          "addressCountry": "US"
        },
        "areaServed": "New Jersey, USA",
        "openingHours": "Mo-Sa 08:00-20:00",
        "priceRange": "$$",
        "sameAs": [activeConfig.googleUrl]
      })} />
    )}

    <!-- BreadcrumbList Schema (genérico - solo si la página no define el suyo) -->
    {!skipBreadcrumb && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": isEn ? "Home" : "Inicio",
            "item": isEn ? `${activeConfig.dominio}/en/` : `${activeConfig.dominio}/`
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": pageTitle,
            "item": fullUrl.endsWith('/') ? fullUrl : `${fullUrl}/`
          }
        ]
      })} />
    )}

    <!-- Preconnect to WhatsApp for faster CTA -->
    <link rel="preconnect" href="https://wa.me" />

    <!-- Leaflet CSS para mapa interactivo -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Google tag (gtag.js) - Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5P8YVWDWEK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5P8YVWDWEK');
    </script>
    <!-- End Google tag (gtag.js) -->
  </head>
  <body class="min-h-screen flex flex-col pt-16 md:pt-20 pb-16 md:pb-0">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    {!skipEpaBadge && <EpaLicenseBadge lang={lang} />}
    <Footer lang={lang} />
    <WhatsAppCTA lang={lang} />
    <BottomNav lang={lang} />
    <GoogleReviewsModal />
    <Analytics />
  </body>
</html>
