---
import { config } from '@/data/config';

interface Props {
  lang?: string;
}

const { lang = 'es-US' } = Astro.props;
const isEn = lang === 'en';

const t = {
  badge: isEn ? 'Federal Certification' : 'Certificación Federal',
  titlePre: isEn ? 'EPA' : 'de la',
  titlePost: isEn ? '' : 'EPA',
  titleLead: isEn ? 'EPA 608' : 'Licencia 608 de la',
  titleTail: isEn ? 'Certification' : '',
  description: isEn
    ? 'Our lead technician is certified by the Environmental Protection Agency (EPA) under Section 608 of the Clean Air Act. This allows us to purchase, handle and recharge refrigerant gas legally in the United States — a mandatory federal requirement for any professional refrigeration and HVAC work.'
    : 'Nuestro técnico principal está certificado por la Environmental Protection Agency (EPA) bajo la Sección 608 del Clean Air Act. Esto nos permite comprar, manejar y recargar gas refrigerante legalmente en Estados Unidos — un requisito federal obligatorio para cualquier trabajo profesional de refrigeración y HVAC.',
  badges: isEn
    ? ['✓ Legal refrigerant handling', '✓ Federal compliance', '✓ Guaranteed safety']
    : ['✓ Manejo legal de refrigerante', '✓ Cumplimiento federal', '✓ Seguridad garantizada'],
};
---

<!-- EPA 608 License Badge - prominently displayed -->
<section class="py-8 md:py-10 relative overflow-hidden">
  <div class="container-x relative">
    <div class="max-w-4xl mx-auto">
      <div class="card-neon p-6 md:p-8 flex flex-col md:flex-row items-center gap-6 text-center md:text-left">
        <div class="shrink-0">
          <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-gradient-neon flex items-center justify-center shadow-neon-lg">
            <span class="text-4xl md:text-5xl">🛡️</span>
          </div>
        </div>
        <div class="flex-1">
          <div class="badge-neon mb-3">{t.badge}</div>
          <h3 class="text-xl md:text-2xl font-display font-bold text-white mb-2">
            {isEn ? (
              <><span class="text-neon-400 glow-text">EPA 608</span> Certification</>
            ) : (
              <>Licencia 608 de la <span class="text-neon-400 glow-text">EPA</span></>
            )}
          </h3>
          <p class="text-sm md:text-base text-white mb-4">{t.description}</p>
          <div class="flex flex-wrap gap-2 justify-center md:justify-start">
            {t.badges.map(b => <span class="badge-neon">{b}</span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
