---
import { config, waLink } from '@/data/config';
import { configEn, waLinkEn } from '@/data/config-en';
import { servicios } from '@/data/servicios';
import { serviciosEn } from '@/data/servicios-en';
import { cities } from '@/data/cities';
import { citiesEn } from '@/data/cities-en';
import LanguageToggle from '@/components/LanguageToggle.astro';

interface Props {
  lang?: string;
}

const { lang = 'es-US' } = Astro.props;
const isEn = lang === 'en';

const activeConfig = isEn ? configEn : config;
const waLinkFn = isEn ? waLinkEn : waLink;
const serviciosMenu = isEn ? serviciosEn : servicios;
const ciudadesTop = (isEn ? citiesEn : cities).slice(0, 6);

const prefix = isEn ? '/en' : '';

const navItems = isEn
  ? [
      { label: 'Home', href: '/en/' },
      { label: 'Services', href: '/en/services/', children: serviciosMenu.map(s => ({ label: `${s.icono} ${s.nombre}`, href: `/en/services/${s.slug}/` })) },
      { label: 'Cities', href: '/en/cities/', children: ciudadesTop.map(c => ({ label: c.nombre, href: `/en/cities/${c.slug}/` })) },
      { label: 'Gallery', href: '/en/gallery/' },
      { label: 'About Us', href: '/en/about/' },
      { label: 'Contact', href: '/en/contact/' },
    ]
  : [
      { label: 'Inicio', href: '/' },
      { label: 'Servicios', href: '/servicios/', children: serviciosMenu.map(s => ({ label: `${s.icono} ${s.nombre}`, href: `/servicios/${s.slug}/` })) },
      { label: 'Ciudades', href: '/cities/', children: ciudadesTop.map(c => ({ label: c.nombre, href: `/cities/${c.slug}/` })) },
      { label: 'Galería', href: '/galeria/' },
      { label: 'Quiénes Somos', href: '/quienes-somos/' },
      { label: 'Contacto', href: '/contacto/' },
    ];

const ariaLabelOpen = isEn ? 'Open menu' : 'Abrir menú';
const logoAriaLabel = isEn ? 'Alexandro Refrigeration HVACR home' : 'Alexandro Refrigeration HVACR inicio';
const epaBadgeTitle = isEn ? 'EPA 608 Certification' : 'Licencia 608 de la EPA';
const epaBadgeSubtitle = isEn ? 'Federal certification active' : 'Certificación federal vigente';
const callLabel = isEn ? 'Call' : 'Llamar';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-dark-300/95 backdrop-blur-md border-b border-neon-500/20 shadow-lg shadow-neon-500/5">
  <div class="container-x">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href={prefix + '/'} class="flex items-center gap-2 group" aria-label={logoAriaLabel}>
        <div class="relative">
          <div class="absolute inset-0 bg-neon-500 blur-lg opacity-50 group-hover:opacity-80 transition-opacity rounded-lg"></div>
          <div class="relative w-12 h-12 md:w-14 md:h-14 flex items-center justify-center bg-dark-200 border-2 border-neon-500 rounded-lg shadow-neon-sm overflow-hidden">
            <img
              src="/images/Refrigeration-HVAC-Repair-in-New-Jersey-logo.webp"
              alt="Alexandro Refrigeration HVACR - Logo"
              width="56"
              height="56"
              class="w-full h-full object-contain"
              loading="eager"
            />
          </div>
        </div>
        <div class="flex flex-col leading-none">
          <span class="font-display font-bold text-sm md:text-lg text-white glow-text tracking-wider">ALEXANDRO REFRIGERATION H.V.A.C.R</span>
          <span class="text-[9px] md:text-xs text-neon-400 uppercase tracking-widest">Parts & Repair Services</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map(item => (
          <div class="relative group">
            <a
              href={item.href}
              class="px-3 py-2 text-sm font-medium text-white hover:text-neon-400 transition-colors uppercase tracking-wide flex items-center gap-1"
            >
              {item.label}
              {item.children && (
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute top-full left-0 mt-1 w-72 bg-dark-200 border border-neon-500/20 rounded-lg shadow-neon opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pt-2 max-h-[70vh] overflow-y-auto z-50">
                {item.children.map(child => (
                  <a
                    href={child.href}
                    class="block px-4 py-2.5 text-sm text-white hover:bg-neon-500/10 hover:text-neon-400 transition-colors border-b border-neon-500/5 last:border-0"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- Language Toggle + Phone + WhatsApp buttons (desktop) -->
      <div class="hidden lg:flex items-center gap-2">
        <LanguageToggle />
        <a
          href={`tel:${activeConfig.telefonoHref}`}
          class="px-3 py-2 text-sm font-bold uppercase tracking-wide rounded-lg border-2 border-neon-500 text-neon-500 hover:bg-neon-500 hover:text-dark-500 hover:shadow-neon transition-all duration-300 flex items-center gap-1.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {activeConfig.telefonoDisplay}
        </a>
        <a href={waLinkFn()} target="_blank" rel="noopener" class="btn-whatsapp text-sm py-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp
        </a>
      </div>

      <!-- Language Toggle (always visible - mobile + desktop) -->
      <div class="lg:hidden">
        <LanguageToggle />
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        aria-label={ariaLabelOpen}
        class="lg:hidden p-2 text-neon-400 hover:bg-neon-500/10 rounded-lg transition-colors"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-neon-500/20 bg-dark-300/95 backdrop-blur-md">
    <nav class="container-x py-4 space-y-2 max-h-[80vh] overflow-y-auto">
      {navItems.map(item => (
        <div class="space-y-1">
          <a
            href={item.href}
            class="block px-3 py-2 text-sm font-medium text-white hover:bg-neon-500/10 hover:text-neon-400 rounded transition-colors uppercase"
          >
            {item.label}
          </a>
          {item.children && (
            <div class="pl-4 space-y-1 border-l border-neon-500/20 ml-3">
              {item.children.map(child => (
                <a href={child.href} class="block px-3 py-1.5 text-xs text-white hover:text-neon-400 transition-colors">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}

      <!-- EPA License badge -->
      <div class="px-3 py-3 mt-3 rounded-lg bg-neon-500/5 border border-neon-500/30 flex items-center gap-2">
        <span class="text-xl">🛡️</span>
        <div>
          <div class="text-xs font-bold text-neon-400 uppercase tracking-wide">{epaBadgeTitle}</div>
          <div class="text-[10px] text-white">{epaBadgeSubtitle}</div>
        </div>
      </div>

      <!-- Language toggle REMOVED from mobile menu - now always visible in header -->
      <div class="flex gap-2 mt-4">
        <a href={`tel:${activeConfig.telefonoHref}`} class="btn-outline-neon flex-1 text-sm py-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {callLabel}
        </a>
        <a href={waLinkFn()} target="_blank" rel="noopener" class="btn-whatsapp flex-1 text-sm py-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
  document.addEventListener('click', (e) => {
    if (!btn?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
      menu?.classList.add('hidden');
    }
  });
</script>
