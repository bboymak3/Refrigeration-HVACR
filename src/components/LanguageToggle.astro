---
/**
 * LanguageToggle.astro
 * 
 * Botón para cambiar entre English (raíz) y Español (/es/).
 * Idioma principal: Inglés (raíz /)
 * Idioma secundario: Español (/es/)
 * Muestra bandera SVG + letras (🇪🇸 ES / 🇬🇧 EN).
 */

// Detectar idioma actual basado en la URL
const currentPath = Astro.url.pathname;
const isSpanish = currentPath.startsWith('/es/');

// Generar URL equivalente en el otro idioma
let targetUrl = '/';
if (isSpanish) {
  targetUrl = currentPath.replace(/^\/es/, '') || '/';
  if (!targetUrl.endsWith('/')) targetUrl += '/';
} else {
  const path = currentPath === '/' ? '' : currentPath;
  targetUrl = `/es${path}`;
  if (!targetUrl.endsWith('/')) targetUrl += '/';
}

const langLabel = isSpanish ? 'EN' : 'ES';
---

<a
  href={targetUrl}
  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-neon-500/30 bg-dark-200/80 text-white hover:bg-neon-500 hover:text-dark-500 transition-all text-[13px] font-bold uppercase tracking-wide whitespace-nowrap"
  aria-label={isSpanish ? 'Switch to English' : 'Cambiar a Español'}
>
  {isSpanish ? (
    <svg width="20" height="14" viewBox="0 0 60 40" xmlns="http://www.w3.org/2000/svg" class="rounded-sm">
      <rect width="60" height="40" fill="#012169"/>
      <path d="M0,0 L60,40 M60,0 L0,40" stroke="#fff" stroke-width="8"/>
      <path d="M0,0 L60,40 M60,0 L0,40" stroke="#C8102E" stroke-width="3"/>
      <path d="M30,0 L30,40 M0,20 L60,20" stroke="#fff" stroke-width="10"/>
      <path d="M30,0 L30,40 M0,20 L60,20" stroke="#C8102E" stroke-width="5"/>
    </svg>
  ) : (
    <svg width="20" height="14" viewBox="0 0 60 40" xmlns="http://www.w3.org/2000/svg" class="rounded-sm">
      <rect width="60" height="40" fill="#c60b1e"/>
      <rect y="10" width="60" height="20" fill="#ffc400"/>
    </svg>
  )}
  {langLabel}
</a>
