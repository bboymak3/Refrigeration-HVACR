---
/**
 * LanguageToggle.astro
 * 
 * Botón para cambiar entre Español e Inglés.
 * Muestra bandera + letras (🇪🇸 ES / 🇬🇧 EN).
 * Visible permanentemente en el Header.
 */

// Detectar idioma actual basado en la URL
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en/');

// Generar URL equivalente en el otro idioma
let targetUrl = '/';
if (isEnglish) {
  // Estamos en inglés, cambiar a español
  targetUrl = currentPath.replace(/^\/en/, '') || '/';
} else {
  // Estamos en español, cambiar a inglés
  const path = currentPath === '/' ? '' : currentPath;
  targetUrl = `/en${path}`;
  // Asegurar trailing slash
  if (!targetUrl.endsWith('/')) targetUrl += '/';
}

// Bandera + texto del idioma al que se va a cambiar
const flagEmoji = isEnglish ? '🇪🇸' : '🇬🇧';
const langLabel = isEnglish ? 'ES' : 'EN';
---

<a
  href={targetUrl}
  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-neon-500/30 bg-dark-200/80 text-white hover:bg-neon-500 hover:text-dark-500 transition-all text-[13px] font-bold uppercase tracking-wide whitespace-nowrap"
  aria-label={isEnglish ? 'Cambiar a Español' : 'Switch to English'}
>
  <span class="text-base leading-none" style="font-size: 1.1rem;">{flagEmoji}</span>
  {langLabel}
</a>
