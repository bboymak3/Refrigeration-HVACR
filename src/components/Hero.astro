---
import { config, waLink } from '@/data/config';
import { configEn, waLinkEn } from '@/data/config-en';

interface Props {
  lang?: string;
}

const { lang = 'es-US' } = Astro.props;
const isEn = lang === 'en';

const activeConfig = isEn ? configEn : config;
const waLinkFn = isEn ? waLinkEn : waLink;

const t = {
  badge: isEn ? 'Available 24/7 · EPA 608 Certified' : 'Disponible 24/7 · EPA 608 Certified',
  h1Line1: isEn ? 'Refrigeration & HVAC Repair - Service' : 'Refrigeration & HVAC Repair - Service',
  h1Line2: isEn ? 'in New Jersey' : 'in New Jersey',
  intro: isEn
    ? 'Welcome to <strong class="text-white">Alexandro Refrigeration HVAC Parts & Repair Services</strong>. We handle commercial refrigeration, HVAC, walk-in coolers and kitchen equipment in 10 cities.'
    : 'Bienvenido a la <strong class="text-white">Compañía Líder en Reparaciones Alexandro Refrigeration HVAC Parts & Repair Services</strong>. Atendemos refrigeración comercial, HVAC, cuartos fríos y equipos de cocina en 10 ciudades.',
  intro2: isEn
    ? 'Repair for <strong class="text-neon-400">restaurants, hotels, supermarkets, liquor stores and cafes</strong> with <strong class="text-neon-400">EPA 608 Certified</strong> technician, professionalism, honesty, responsibility and 3-month warranty.'
    : 'Reparación para <strong class="text-neon-400">restaurantes, hoteles, supermercados, licorerías y cafeterías</strong> con técnico certificado <strong class="text-neon-400">Licencia 608 de la EPA</strong>, profesionalismo, honestidad, responsabilidad y garantía de 3 meses.',
  ctaWhats: isEn ? 'Book on WhatsApp' : 'Agenda por WhatsApp',
  statClients: isEn ? 'Clients' : 'Clientes',
  statCities: isEn ? 'Cities' : 'Ciudades',
  statExperience: isEn ? 'Experience' : 'Experiencia',
  statWarranty: isEn ? 'Warranty' : 'Garantía',
};
---

<section class="relative overflow-hidden pt-8 pb-16 md:pt-12 md:pb-24">
  <!-- Grid background -->
  <div class="absolute inset-0 bg-grid opacity-30"></div>

  <!-- Glow orbs decorativos -->
  <div class="absolute top-20 -left-20 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 -right-20 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl"></div>

  <div class="container-x relative">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- LEFT: Texto -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <!-- Badge de disponibilidad + EPA -->
        <div class="inline-flex items-center gap-2 badge-neon mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-neon-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-neon-500"></span>
          </span>
          {t.badge}
        </div>

        <!-- H1 -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-[#4267B2] mb-6 leading-tight text-balance">
          <span class="block">{t.h1Line1}</span>
          <span class="block text-transparent bg-clip-text bg-gradient-neon glow-text">{t.h1Line2}</span>
        </h1>

        <!-- Párrafo principal -->
        <p class="text-lg md:text-xl text-white mb-6 max-w-xl mx-auto lg:mx-0 leading-relaxed" set:html={t.intro} />

        <!-- Párrafo secundario -->
        <p class="text-base md:text-lg text-white mb-8 max-w-xl mx-auto lg:mx-0" set:html={t.intro2} />

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-10">
          <a href={waLinkFn()} target="_blank" rel="noopener" class="btn-whatsapp text-base md:text-lg animate-pulse-neon">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            {t.ctaWhats}
          </a>
          <a href={`tel:${activeConfig.telefonoHref}`} class="btn-outline-neon text-base md:text-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {activeConfig.telefonoDisplay}
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 lg:gap-6 max-w-xl mx-auto lg:mx-0">
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{activeConfig.stats.clientes}</div>
            <div class="text-xs text-white uppercase tracking-wide">{t.statClients}</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{activeConfig.stats.cobertura}</div>
            <div class="text-xs text-white uppercase tracking-wide">{t.statCities}</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{activeConfig.stats.experiencia}</div>
            <div class="text-xs text-white uppercase tracking-wide">{t.statExperience}</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{activeConfig.stats.garantia}</div>
            <div class="text-xs text-white uppercase tracking-wide">{t.statWarranty}</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Tarjeta visual con EPA badge -->
      <div class="relative order-1 lg:order-2">
        <div class="relative max-w-lg mx-auto">
          <!-- Glow ring -->
          <div class="absolute -inset-4 rounded-2xl bg-gradient-neon opacity-20 blur-2xl"></div>

          <!-- Tarjeta principal -->
          <div class="relative aspect-square rounded-2xl overflow-hidden border-2 border-neon-500/40 shadow-neon-lg bg-gradient-to-br from-dark-200 via-dark-300 to-dark-400">
            <!-- Logo central flotando -->
            <div class="absolute inset-0 flex items-center justify-center p-8">
              <img
                src="/images/Refrigeration-HVAC-Repair-in-New-Jersey-logo.webp"
                alt="Alexandro Refrigeration HVACR - Logo"
                class="w-full h-full object-contain animate-float drop-shadow-[0_0_30px_rgba(0,212,255,0.4)]"
                loading="eager"
              />
            </div>

            <!-- Badge flotante superior -->
            <div class="absolute top-4 left-4 px-3 py-1.5 bg-neon-500/90 backdrop-blur rounded-lg border border-neon-400 text-dark-500 text-xs font-bold uppercase tracking-wider shadow-neon">
              🛡️ EPA 608 Certified
            </div>

            <!-- Texto inferior -->
            <div class="absolute bottom-4 left-4 right-4">
              <div class="text-xs text-neon-400 uppercase tracking-wider mb-1 font-semibold">ALEXANDRO HVACR</div>
              <div class="text-white font-display font-bold text-lg leading-tight">Refrigeration & HVAC Repair - Service</div>
            </div>
          </div>

          <!-- Floating badges (solo desktop) -->
          <div class="hidden md:block absolute top-8 -right-4 card-neon p-3 animate-float" style="animation-delay: 0s;">
            <div class="flex items-center gap-2">
              <span class="text-2xl">🛠️</span>
              <div>
                <div class="text-xs text-white">{isEn ? 'Warranty' : 'Garantía'}</div>
                <div class="text-sm font-bold text-neon-400">{isEn ? '3 months' : '3 meses'}</div>
              </div>
            </div>
          </div>
          <div class="hidden md:block absolute bottom-12 -left-4 card-neon p-3 animate-float" style="animation-delay: 1s;">
            <div class="flex items-center gap-2">
              <span class="text-2xl">⚡</span>
              <div>
                <div class="text-xs text-white">{isEn ? 'Emergencies' : 'Emergencias'}</div>
                <div class="text-sm font-bold text-neon-400">24/7</div>
              </div>
            </div>
          </div>
          <div class="hidden lg:block absolute top-1/2 -right-8 card-neon p-3 animate-float" style="animation-delay: 2s;">
            <div class="flex items-center gap-2">
              <span class="text-2xl">🏪</span>
              <div>
                <div class="text-xs text-white">{isEn ? 'For' : 'Para'}</div>
                <div class="text-sm font-bold text-neon-400">{isEn ? 'Businesses' : 'Negocios'}</div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
