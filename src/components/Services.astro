---
import { servicios, getServiciosDestacados, getServiciosRegulares } from '@/data/servicios';
import { waLinkServicio } from '@/data/config';
import { getImagenParaServicio, getImagenUrl } from '@/data/galeria';

const destacados = getServiciosDestacados();
const serviciosRegulares = getServiciosRegulares();
---

<section id="servicios" class="py-20 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-10"></div>

  <div class="container-x relative">
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="badge-neon mb-4">Servicios</span>
      <h2 class="section-title">Servicios de Refrigeración & HVAC</h2>
      <p class="section-subtitle">
        {servicios.length} servicios especializados de refrigeración comercial, HVAC y equipos de cocina en New Jersey. Diagnóstico profesional, repuestos de calidad y garantía escrita de 3 meses en cada trabajo.
      </p>
    </div>

    <!-- Servicio destacado naranja -->
    {destacados.map(servicio => (
      <div class="mb-8 max-w-5xl mx-auto">
        <a href={`/servicios/${servicio.slug}/`} class="block card-orange group">
          <div class="grid md:grid-cols-[auto_1fr_auto] gap-6 items-center">
            <div class="w-20 h-20 rounded-lg bg-orange-500/10 border-2 border-orange-500 flex items-center justify-center text-5xl shadow-orange-neon animate-pulse-orange shrink-0">
              {servicio.icono}
            </div>
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="badge-orange">{servicio.categoria}</span>
                <span class="text-[10px] px-2 py-0.5 bg-orange-500 text-dark-500 rounded font-bold uppercase">★ Destacado</span>
              </div>
              <h3 class="text-2xl font-display font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">
                {servicio.nombre}
              </h3>
              <p class="text-sm text-white/90 mb-3">{servicio.descripcionCorta}</p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="badge-orange">Refrigeradores</span>
                <span class="badge-orange">Vitrinas</span>
                <span class="badge-orange">Walk-in Coolers</span>
              </div>
            </div>
            <div class="text-orange-400">
              <svg class="w-8 h-8 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </div>
          </div>
        </a>
      </div>
    ))}

    <!-- Grid de servicios regulares -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {serviciosRegulares.map((servicio, i) => {
        const imagen = getImagenParaServicio(servicio.slug);
        return (
        <article class="group relative overflow-hidden bg-dark-200 border border-neon-500/20 rounded-xl transition-all duration-300 hover:border-neon-500/60 hover:shadow-neon hover:-translate-y-1">
          <!-- Imagen real del servicio -->
          <a href={`/servicios/${servicio.slug}/`} class="block relative aspect-[4/3] overflow-hidden rounded-t-xl border-b border-neon-500/20">
            <img
              src={getImagenUrl(imagen)}
              alt={`Foto real de ${servicio.nombre} en New Jersey`}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
            <div class="absolute top-2 left-2 px-2 py-1 bg-dark-300/80 backdrop-blur rounded text-[10px] text-neon-400 uppercase tracking-wide border border-neon-500/30">
              {servicio.categoria}
            </div>
          </a>

          <div class="relative p-5">
            <!-- Número decorativo -->
            <div class="absolute top-4 right-4 text-6xl font-display font-bold text-neon-500/5 select-none">
              {String(i + 1).padStart(2, '0')}
            </div>

            <!-- Icono -->
            <div class="w-12 h-12 rounded-lg bg-neon-500/10 border border-neon-500/30 flex items-center justify-center mb-4 group-hover:shadow-neon transition-shadow">
              <span class="text-2xl">{servicio.icono}</span>
            </div>

            <!-- Título -->
            <h3 class="text-lg font-display font-bold text-white mb-3 group-hover:text-neon-400 transition-colors">
              <a href={`/servicios/${servicio.slug}/`}>{servicio.nombre}</a>
            </h3>

            <!-- Descripción -->
            <p class="text-sm text-white/90 mb-5 line-clamp-2">
              {servicio.descripcionCorta}
            </p>

            <!-- Acciones -->
            <div class="flex flex-col gap-2">
              <a href={`/servicios/${servicio.slug}/`} class="text-sm font-semibold text-neon-400 hover:text-neon-300 transition-colors inline-flex items-center gap-1">
                Ver detalles
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
              <a
                href={waLinkServicio(servicio.nombre)}
                target="_blank"
                rel="noopener"
                class="text-xs px-3 py-2 rounded-md bg-[#25D366]/10 border border-[#25D366]/30 text-[#25D366] hover:bg-[#25D366] hover:text-white transition-all inline-flex items-center gap-1.5 w-fit"
              >
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                Cotizar por WhatsApp
              </a>
            </div>
          </div>

          <!-- Glow border on hover -->
          <div class="absolute inset-0 rounded-xl border border-neon-500/0 group-hover:border-neon-500/40 transition-colors pointer-events-none"></div>
        </article>
        );
      })}
    </div>

    <!-- CTA inferior -->
    <div class="text-center mt-12">
      <p class="text-white/90 mb-4">¿No encuentras lo que necesitas? Escríbenos por WhatsApp.</p>
      <a href={waLinkServicio('un servicio personalizado')} target="_blank" rel="noopener" class="btn-whatsapp">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Consultar servicio
      </a>
    </div>
  </div>
</section>
