---
import { cities } from '@/data/cities';
import { waLinkCiudad } from '@/data/config';

const cityDestacada = cities.find(c => c.destacada);
---

<section class="py-16 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-neon-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-x relative">
    <div class="text-center mb-10">
      <span class="badge-neon mb-4">Cobertura en New Jersey</span>
      <h2 class="text-3xl md:text-4xl font-display font-extrabold text-[#4267B2] mb-4">
        Ciudades que <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">Cubrimos</span>
      </h2>
      <p class="text-white max-w-2xl mx-auto">
        Atendemos {cities.length} ciudades de New Jersey con servicio de refrigeración comercial y HVAC. Selecciona tu ciudad para ver los servicios disponibles y contactarnos directamente.
      </p>
    </div>

    <!-- Grid de ciudades -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {cities.map(c => (
        <a
          href={`/cities/${c.slug}/`}
          class={`card-neon group text-center ${c.destacada ? 'border-orange-500/50 hover:border-orange-500' : ''}`}
        >
          <div class={`w-14 h-14 mx-auto rounded-full ${c.destacada ? 'bg-orange-500/10 border-2 border-orange-500' : 'bg-neon-500/10 border-2 border-neon-500/30'} flex items-center justify-center mb-3 group-hover:scale-110 transition-transform`}>
            <svg class={`w-7 h-7 ${c.destacada ? 'text-orange-400' : 'text-neon-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class={`font-display font-bold text-base ${c.destacada ? 'text-orange-400' : 'text-white group-hover:text-neon-400'} transition-colors`}>
            {c.nombre}
          </h3>
          <div class={`text-[10px] uppercase tracking-wider mt-1 ${c.destacada ? 'text-orange-400/70' : 'text-neon-400/70'}`}>USA</div>
          {c.destacada && (
            <div class="mt-2 text-[10px] px-2 py-0.5 bg-orange-500 text-dark-500 rounded font-bold uppercase tracking-wider inline-block">★ Destacada</div>
          )}
        </a>
      ))}
    </div>

    <!-- CTA inferior -->
    <div class="text-center mt-10">
      <p class="text-sm text-white mb-3">¿Tu ciudad no está en la lista? Probablemente también te atendemos.</p>
      <a href={waLinkCiudad('mi ciudad de New Jersey')} target="_blank" rel="noopener" class="btn-whatsapp text-sm">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Consultar cobertura
      </a>
    </div>
  </div>
</section>
