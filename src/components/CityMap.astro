---
import { cities } from '@/data/cities';

// Generar array de ciudades con coordenadas
const citiesMapa = cities.map(c => ({
  nombre: c.nombre,
  slug: c.slug,
  coords: [c.lat, c.lng] as [number, number],
  destacada: c.destacada || false,
}));

// Serializar datos para el script
const citiesJson = JSON.stringify(citiesMapa);

// Centro aproximado de las 10 ciudades NJ
const centerLat = cities.reduce((s, c) => s + c.lat, 0) / cities.length;
const centerLng = cities.reduce((s, c) => s + c.lng, 0) / cities.length;
---

<!-- Contenedor del mapa Leaflet -->
<div id="city-map-leaflet" style="height: 520px; background: #0a0a0a; border-radius: 12px; overflow: hidden; border: 1px solid rgba(0, 212, 255, 0.2);"></div>

<!-- Leyenda -->
<div class="flex flex-wrap gap-3 mt-4 justify-center">
  <div class="flex items-center gap-2">
    <div class="w-3 h-3 rounded-full" style="background: #00d4ff; box-shadow: 0 0 8px #00d4ff;"></div>
    <span class="text-xs text-gray-400">Ciudad atendida</span>
  </div>
  <div class="flex items-center gap-2">
    <div class="w-3 h-3 rounded-full" style="background: #ff8a00; box-shadow: 0 0 8px #ff8a00;"></div>
    <span class="text-xs text-gray-400">Ciudad destacada (Newark)</span>
  </div>
</div>

<script is:inline define:vars={{ citiesJson, centerLat, centerLng }}>
  (function() {
    const cities = JSON.parse(citiesJson);
    let map = null;
    let markers = [];

    function initMap() {
      const container = document.getElementById('city-map-leaflet');
      if (!container || typeof L === 'undefined') return;
      if (map) { map.remove(); map = null; markers = []; }

      // Crear mapa centrado en NJ
      map = L.map('city-map-leaflet', {
        center: [centerLat, centerLng],
        zoom: 11,
        zoomControl: true,
        attributionControl: true,
        scrollWheelZoom: false,
      });

      // Tile layer dark de CARTO
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap, © CARTO',
        maxZoom: 18,
      }).addTo(map);

      // Agregar marcadores para cada ciudad
      cities.forEach(function(c) {
        const color = c.destacada ? '#ff8a00' : '#00d4ff';
        const marker = L.circleMarker(c.coords, {
          radius: c.destacada ? 9 : 7,
          fillColor: color,
          color: '#ffffff',
          weight: 1.5,
          opacity: 0.9,
          fillOpacity: 0.7,
        }).addTo(map);

        marker.bindTooltip(
          '<div style="font-weight:600;color:' + color + ';">' + c.nombre + ', NJ</div>' +
          '<div style="font-size:0.7rem;color:#94a3b8;">Refrigeration & HVAC Repair</div>' +
          '<div style="font-size:0.7rem;color:#00d4ff;margin-top:4px;">Click para ver servicios</div>',
          {
            className: 'city-tooltip',
            direction: 'top',
            offset: [0, -8],
          }
        );

        marker.on('click', function() {
          window.location.href = '/cities/' + c.slug + '/';
        });

        marker.on('mouseover', function() {
          marker.setStyle({ radius: c.destacada ? 12 : 10, fillOpacity: 0.9 });
        });
        marker.on('mouseout', function() {
          marker.setStyle({ radius: c.destacada ? 9 : 7, fillOpacity: 0.7 });
        });

        markers.push(marker);
      });

      // Habilitar scroll zoom al hacer click en el mapa
      container.addEventListener('click', function() {
        map.scrollWheelZoom.enable();
      });
      container.addEventListener('mouseleave', function() {
        map.scrollWheelZoom.disable();
      });
    }

    // Función para resaltar una ciudad en el mapa
    window.resaltarCityEnMapa = function(slug, nombre) {
      if (!map) { initMap(); }
      if (!map) return;

      markers.forEach(function(m) {
        m.setStyle({ radius: 7, fillOpacity: 0.7, weight: 1.5 });
      });

      const idx = cities.findIndex(function(c) { return c.slug === slug; });
      if (idx >= 0 && markers[idx]) {
        const c = cities[idx];
        const marker = markers[idx];
        marker.setStyle({ radius: 12, fillOpacity: 1, weight: 3, color: '#ffffff' });
        marker.openTooltip();
        map.flyTo(c.coords, 13, { duration: 0.8 });
      }
    };

    // Cargar Leaflet si no está cargado
    if (typeof L === 'undefined') {
      var script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.onload = initMap;
      document.head.appendChild(script);
      if (!document.querySelector('link[href*="leaflet"]')) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(link);
      }
    } else {
      initMap();
    }

    window.initCityMap = initMap;
  })();
</script>

<style>
  .city-tooltip {
    background: #0a0a0a !important;
    border: 1px solid rgba(0, 212, 255, 0.3) !important;
    border-radius: 8px !important;
    padding: 8px 12px !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5) !important;
  }
  .city-tooltip::before {
    border-top-color: #0a0a0a !important;
  }
  .leaflet-container {
    background: #0a0a0a !important;
  }
  .leaflet-control-zoom a {
    background: #141414 !important;
    color: #00d4ff !important;
    border: 1px solid rgba(0, 212, 255, 0.2) !important;
  }
  .leaflet-control-zoom a:hover {
    background: #00d4ff !important;
    color: #0a0a0a !important;
  }
  .leaflet-control-attribution {
    background: rgba(10, 10, 10, 0.8) !important;
    color: #64748b !important;
  }
  .leaflet-control-attribution a {
    color: #00d4ff !important;
  }
</style>
