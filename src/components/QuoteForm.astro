---
import { cities } from '@/data/cities';
import { citiesEn } from '@/data/cities-en';
import { servicios } from '@/data/servicios';
import { serviciosEn } from '@/data/servicios-en';
import { config, waLink } from '@/data/config';
import { configEn, waLinkEn } from '@/data/config-en';

interface Props {
  lang?: string;
}

const { lang = 'es-US' } = Astro.props;
const isEn = lang === 'en';

const activeConfig = isEn ? configEn : config;
const waLinkFn = isEn ? waLinkEn : waLink;
const citiesData = isEn ? citiesEn : cities;
const serviciosData = isEn ? serviciosEn : servicios;
const privacyLink = isEn ? '/en/privacy-policy/' : '/politica-privacidad/';

const t = {
  badge: isEn ? 'Quick Quote' : 'Cotización Rápida',
  title: isEn ? 'Request Your Free Quote' : 'Solicita tu Cotización Gratis',
  subtitle: isEn
    ? 'Fill out the form and get a quote on WhatsApp in minutes. We serve with EPA 608 certified technician.'
    : 'Completa el formulario y recibe una cotización por WhatsApp en minutos. Atendemos con técnico certificado EPA 608.',
  name: isEn ? 'Name' : 'Nombre',
  namePlaceholder: isEn ? 'Your full name' : 'Tu nombre completo',
  phone: isEn ? 'Phone' : 'Teléfono',
  phonePlaceholder: '201-555-0123',
  city: isEn ? 'City' : 'Ciudad',
  cityPlaceholder: isEn ? 'Select your city' : 'Selecciona tu ciudad',
  otherCity: isEn ? 'Other city' : 'Otra ciudad',
  service: isEn ? 'Service of interest' : 'Servicio de interés',
  servicePlaceholder: isEn ? 'Select a service' : 'Selecciona un servicio',
  otherService: isEn ? 'Other / Not sure' : 'Otro / No estoy seguro',
  detail: isEn ? 'Describe your issue or inquiry' : 'Detalla tu falla o consulta',
  detailPlaceholder: isEn
    ? 'Ex: The commercial refrigerator is not cooling, the AC will not turn on, the walk-in cooler is losing temperature, etc.'
    : 'Ej: El refrigerador comercial no enfría, el AC no enciende, el walk-in cooler pierde temperatura, etc.',
  consent: isEn
    ? 'I agree to my data being stored to process my quote request, according to the'
    : 'Acepto que mis datos sean almacenados para procesar mi solicitud de cotización, según las',
  privacyLink: isEn ? 'Privacy Policy' : 'Políticas de Privacidad',
  submit: isEn ? 'Send and open WhatsApp' : 'Enviar y abrir WhatsApp',
  directWhats: isEn ? 'Direct WhatsApp' : 'WhatsApp directo',
  helpText: isEn
    ? 'When you submit the form, WhatsApp will open with a pre-filled message so you can confirm sending.'
    : 'Al enviar el formulario, se abrirá WhatsApp con el mensaje pre-armado para que confirmes el envío.',
  consentAlert: isEn ? 'You must accept the privacy policy to continue.' : 'Debes aceptar las políticas de privacidad para continuar.',
  successAlert: isEn ? 'Quote sent! Redirecting you to WhatsApp to confirm.' : '¡Cotización enviada! Te redirigimos a WhatsApp para confirmar.',
  msgTitle: isEn ? 'NEW QUOTE - ALEXANDRO HVACR' : 'NUEVA COTIZACIÓN - ALEXANDRO HVACR',
  msgName: isEn ? 'Name' : 'Nombre',
  msgPhone: isEn ? 'Phone' : 'Teléfono',
  msgCity: isEn ? 'City' : 'Ciudad',
  msgService: isEn ? 'Service' : 'Servicio',
  msgDetail: isEn ? 'Detail' : 'Detalle',
};
---

<section id="cotizacion" class="py-20 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-20"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-neon-500/5 rounded-full blur-3xl"></div>

  <div class="container-x relative">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <span class="badge-neon mb-4">{t.badge}</span>
        <h2 class="section-title">{t.title}</h2>
        <p class="section-subtitle">{t.subtitle}</p>
      </div>

      <form id="quote-form" class="card-neon space-y-5">
        <!-- Nombre -->
        <div>
          <label for="nombre" class="block text-sm font-medium text-white mb-2">
            {t.name} <span class="text-neon-400">*</span>
          </label>
          <input type="text" id="nombre" name="nombre" required placeholder={t.namePlaceholder} class="input-neon" />
        </div>

        <!-- Teléfono + Ciudad -->
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label for="telefono" class="block text-sm font-medium text-white mb-2">
              {t.phone} <span class="text-neon-400">*</span>
            </label>
            <input type="tel" id="telefono" name="telefono" required placeholder={t.phonePlaceholder} class="input-neon" />
          </div>
          <div>
            <label for="ciudad" class="block text-sm font-medium text-white mb-2">
              {t.city} <span class="text-neon-400">*</span>
            </label>
            <select id="ciudad" name="ciudad" required class="input-neon">
              <option value="">{t.cityPlaceholder}</option>
              {citiesData.map(c => (
                <option value={c.nombre}>{c.nombre}</option>
              ))}
              <option value="Otra">{t.otherCity}</option>
            </select>
          </div>
        </div>

        <!-- Servicio -->
        <div>
          <label for="servicio" class="block text-sm font-medium text-white mb-2">
            {t.service} <span class="text-neon-400">*</span>
          </label>
          <select id="servicio" name="servicio" required class="input-neon">
            <option value="">{t.servicePlaceholder}</option>
            {serviciosData.map(s => (
              <option value={s.nombre}>{s.icono} {s.nombre}</option>
            ))}
            <option value="Otro">{t.otherService}</option>
          </select>
        </div>

        <!-- Detalle -->
        <div>
          <label for="mensaje" class="block text-sm font-medium text-white mb-2">
            {t.detail} <span class="text-neon-400">*</span>
          </label>
          <textarea id="mensaje" name="mensaje" required rows="4" placeholder={t.detailPlaceholder} class="input-neon resize-none"></textarea>
        </div>

        <!-- Consentimiento -->
        <div class="flex items-start gap-3">
          <input type="checkbox" id="consentimiento" name="consentimiento" required class="mt-1 w-4 h-4 rounded border-neon-500/30 bg-dark-100 text-neon-500 focus:ring-neon-500/30" />
          <label for="consentimiento" class="text-xs text-white">
            {t.consent} <a href={privacyLink} class="text-neon-400 hover:underline">{t.privacyLink}</a>.
          </label>
        </div>

        <!-- Submit -->
        <div class="flex flex-col sm:flex-row gap-3">
          <button type="submit" class="btn-neon flex-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            {t.submit}
          </button>
          <a href={waLinkFn()} target="_blank" rel="noopener" class="btn-whatsapp flex-1">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            {t.directWhats}
          </a>
        </div>

        <p class="text-xs text-white text-center">{t.helpText}</p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ whatsappNumero: activeConfig.whatsappNumero, t }}>
  const form = document.getElementById('quote-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    if (!data.consentimiento) {
      alert(t.consentAlert);
      return;
    }

    // Armar mensaje de WhatsApp
    const mensaje = `*${t.msgTitle}*%0A%0A` +
      `*${t.msgName}:* ${data.nombre}%0A` +
      `*${t.msgPhone}:* ${data.telefono}%0A` +
      `*${t.msgCity}:* ${data.ciudad}%0A` +
      `*${t.msgService}:* ${data.servicio}%0A` +
      `%0A*${t.msgDetail}:*%0A${data.mensaje}`;

    // Abrir WhatsApp
    window.open(`https://wa.me/${whatsappNumero}?text=${encodeURIComponent(mensaje).replace(/%2520/g, '%20')}`, '_blank');

    // Resetear form
    form.reset();
    alert(t.successAlert);
  });
</script>
