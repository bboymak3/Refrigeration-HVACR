---
import { config, waLink } from '@/data/config';
import { configEn, waLinkEn } from '@/data/config-en';
import { servicios } from '@/data/servicios';
import { serviciosEn } from '@/data/servicios-en';
import { cities } from '@/data/cities';
import { citiesEn } from '@/data/cities-en';

interface Props {
  lang?: string;
}

const { lang = 'es-US' } = Astro.props;
const isEn = lang === 'en';

const activeConfig = isEn ? configEn : config;
const waLinkFn = isEn ? waLinkEn : waLink;
const serviciosTop = (isEn ? serviciosEn : servicios).slice(0, 6);
const ciudadesTop = isEn ? citiesEn : cities;
const prefix = isEn ? '/en' : '';

const year = new Date().getFullYear();

const t = {
  ctaTitle: isEn ? 'Need <span class="text-neon-400 glow-text">Refrigeration & HVAC Repair</span>?' : '¿Necesitas <span class="text-neon-400 glow-text">Refrigeration & HVAC Repair</span>?',
  ctaText: isEn
    ? 'We serve 10 cities with EPA 608 certified technician. Commercial, residential and emergency repair. Message us on WhatsApp to coordinate the visit.'
    : 'Atendemos 10 ciudades con técnico certificado EPA 608. Reparación comercial, residencial y de emergencia. Escríbenos por WhatsApp y coordinamos la visita.',
  quoteBtn: isEn ? 'Request Quote' : 'Solicitar Cotización',
  aboutText: isEn
    ? 'Alexandro Refrigeration H.V.A.C.R Parts & Repair Services — your trusted partner for commercial refrigeration, HVAC, walk-in coolers, freezers, stoves, ovens and fryers repair. EPA 608 Certified technician, 3-month warranty, 24/7 emergencies.'
    : 'Alexandro Refrigeration H.V.A.C.R Parts & Repair Services — tu socio de confianza para reparación de refrigeración comercial, HVAC, cuartos fríos, freezers, estufas, hornos y freidoras. Técnico certificado EPA 608, garantía de 3 meses, emergencias 24/7.',
  epaBadgeTitle: isEn ? 'EPA 608 Certified' : 'EPA 608 Certified',
  epaBadgeSubtitle: isEn ? 'Active federal license' : 'Licencia federal vigente',
  servicesTitle: isEn ? 'Services' : 'Servicios',
  citiesTitle: isEn ? 'Cities' : 'Ciudades',
  companyTitle: isEn ? 'Company' : 'Empresa',
  contactTitle: isEn ? 'Contact' : 'Contacto',
  viewAllServices: isEn ? 'View all services →' : 'Ver todos los servicios →',
  aboutLink: isEn ? 'About Us' : 'Quiénes Somos',
  galleryLink: isEn ? 'Gallery' : 'Galería',
  contactLink: isEn ? 'Contact' : 'Contacto',
  privacyLink: isEn ? 'Privacy Policy' : 'Política de Privacidad',
  sitemapLink: isEn ? 'Sitemap' : 'Sitemap',
  coverageLabel: isEn ? 'Coverage 10 cities' : 'Cobertura 10 ciudades',
  googleProfile: isEn ? 'Google Profile' : 'Perfil de Google',
  copyright: isEn
    ? `© ${year} ${activeConfig.marcaLarga}. All rights reserved. Refrigeration & HVAC Repair. EPA 608 Certified.`
    : `© ${year} ${activeConfig.marcaLarga}. Todos los derechos reservados. Refrigeration & HVAC Repair. EPA 608 Certified.`,
};

const linkMap = isEn
  ? {
      serviciosBase: '/en/services/',
      citiesBase: '/en/cities/',
      quienes: '/en/about/',
      galeria: '/en/gallery/',
      contacto: '/en/contact/',
      privacidad: '/en/privacy-policy/',
    }
  : {
      serviciosBase: '/servicios/',
      citiesBase: '/cities/',
      quienes: '/quienes-somos/',
      galeria: '/galeria/',
      contacto: '/contacto/',
      privacidad: '/politica-privacidad/',
    };
---

<footer class="bg-dark-400 border-t border-neon-500/20 mt-20">
  <!-- CTA superior -->
  <div class="container-x py-12 border-b border-neon-500/10">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div>
        <h3 class="text-2xl md:text-3xl font-display font-bold text-white mb-3" set:html={t.ctaTitle} />
        <p class="text-white">{t.ctaText}</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 md:justify-end">
        <a href={waLinkFn()} target="_blank" rel="noopener" class="btn-whatsapp">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          {activeConfig.telefonoDisplay}
        </a>
        <a href={linkMap.contacto} class="btn-outline-neon">{t.quoteBtn}</a>
      </div>
    </div>
  </div>

  <!-- Footer principal -->
  <div class="container-x py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <!-- Columna 1: Marca -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-dark-200 border-2 border-neon-500 rounded-lg overflow-hidden">
            <img
              src="/images/Refrigeration-HVAC-Repair-in-New-Jersey-logo.webp"
              alt="Alexandro Refrigeration HVACR - Logo"
              width="48"
              height="48"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col leading-none">
            <span class="font-display font-bold text-base text-white tracking-wider">ALEXANDRO REFRIGERATION H.V.A.C.R</span>
            <span class="text-[10px] text-neon-400 uppercase tracking-widest">{isEn ? 'Parts & Repair Services' : 'Repuestos & Servicios de Reparación'}</span>
          </div>
        </div>
        <p class="text-sm text-white">{t.aboutText}</p>
        <!-- EPA License badge -->
        <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-neon-500/10 border border-neon-500/40">
          <span class="text-xl">🛡️</span>
          <div>
            <div class="text-xs font-bold text-neon-400 uppercase tracking-wide">{t.epaBadgeTitle}</div>
            <div class="text-[10px] text-white">{t.epaBadgeSubtitle}</div>
          </div>
        </div>
      </div>

      <!-- Columna 2: Servicios -->
      <div>
        <h4 class="text-sm font-display font-bold uppercase tracking-widest text-neon-400 mb-4">{t.servicesTitle}</h4>
        <ul class="space-y-2">
          {serviciosTop.map(s => (
            <li>
              <a href={`${linkMap.serviciosBase}${s.slug}/`} class="text-sm text-white hover:text-neon-400 transition-colors">
                {s.nombre}
              </a>
            </li>
          ))}
          <li>
            <a href={linkMap.serviciosBase} class="text-sm text-neon-400 font-semibold hover:underline">{t.viewAllServices}</a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Ciudades -->
      <div>
        <h4 class="text-sm font-display font-bold uppercase tracking-widest text-neon-400 mb-4">{t.citiesTitle}</h4>
        <ul class="space-y-2 grid grid-cols-2 gap-x-4">
          {ciudadesTop.map(c => (
            <li>
              <a href={`${linkMap.citiesBase}${c.slug}/`} class="text-sm text-white hover:text-neon-400 transition-colors">
                {c.nombre}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 4: Empresa -->
      <div>
        <h4 class="text-sm font-display font-bold uppercase tracking-widest text-neon-400 mb-4">{t.companyTitle}</h4>
        <ul class="space-y-2">
          <li><a href={linkMap.quienes} class="text-sm text-white hover:text-neon-400 transition-colors">{t.aboutLink}</a></li>
          <li><a href={linkMap.galeria} class="text-sm text-white hover:text-neon-400 transition-colors">{t.galleryLink}</a></li>
          <li><a href={linkMap.contacto} class="text-sm text-white hover:text-neon-400 transition-colors">{t.contactLink}</a></li>
          <li><a href={linkMap.privacidad} class="text-sm text-white hover:text-neon-400 transition-colors">{t.privacyLink}</a></li>
          <li><a href="/sitemap.xml" class="text-sm text-white hover:text-neon-400 transition-colors">{t.sitemapLink}</a></li>
        </ul>
      </div>

      <!-- Columna 5: Contacto -->
      <div>
        <h4 class="text-sm font-display font-bold uppercase tracking-widest text-neon-400 mb-4">{t.contactTitle}</h4>
        <ul class="space-y-3 text-sm text-white">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>USA<br/><span class="text-neon-400">{t.coverageLabel}</span></span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>{activeConfig.horario}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${activeConfig.telefonoHref}`} class="hover:text-neon-400 transition-colors">{activeConfig.telefonoDisplay}</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-neon-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <a href={waLinkFn()} target="_blank" rel="noopener" class="hover:text-neon-400 transition-colors">WhatsApp</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-neon-400 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            <a href={activeConfig.googleUrl} target="_blank" rel="noopener" class="hover:text-neon-400 transition-colors">{t.googleProfile}</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Footer bottom -->
  <div class="border-t border-neon-500/10">
    <div class="container-x py-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-white text-center md:text-left">{t.copyright}</p>
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <span class="text-white">🛡️ EPA 608 Certified</span>
        <a href={linkMap.quienes} class="text-white hover:text-neon-400 transition-colors">{t.aboutLink}</a>
        <a href={linkMap.contacto} class="text-white hover:text-neon-400 transition-colors">{t.contactLink}</a>
        <a href={linkMap.privacidad} class="text-white hover:text-neon-400 transition-colors">{t.privacyLink}</a>
        <a href="/sitemap.xml" class="text-white hover:text-neon-400 transition-colors">{t.sitemapLink}</a>
      </div>
    </div>
  </div>
</footer>
